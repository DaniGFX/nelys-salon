# ==========================================
# 4. Database Dumps, Backups & Local DBs
# ==========================================
# All database dump and data files across any directory
*.sql
*.dump
*.sql.bak
*.sql.gz
*.sql.bz2
*.sql.tar.gz
*.sql.tar
*.sql.zip
*.sql.7z
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.s3db
*.rdb
*.ibd
*.frm
*.myd
*.myi
*.opt
*backup*.sql
*dump*.sql
*export*.sql
*snapshot*.sql
/backups/
/database_backups/
/db_backups/
/db-dumps/
/dumps/
/sql_backups/

# Whitelist core database migrations and seed templates for deployment
!server/db/schema.sql
!server/db/seeds.sql
!server/db/migrations/*.sql
!server/db/migrations/**/*.sql

