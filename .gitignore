# ==============================================================================
# NELY'S SALON MANAGEMENT SYSTEM — .gitignore
# Comprehensive Security & Privacy Rules:
# - Secrets, Environment Variables & API Credentials
# - Payment Gateway, SMS & SMTP Secrets
# - Database Dumps, Exports & Customer Financial Records
# - User Uploads, Receipts & Attachments
# - Scratch, Debug & Audit Scripts
# - Server Logs, Session Files & Caches
# - Cloud CLI State, IDEs, Editors & OS Files
# ==============================================================================

# ==========================================
# 1. Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
.env.local
.env.development
.env.staging
.env.production
.env.backup
.env.dist.local
*.env
!.env.example

# Local server configurations and credential overrides
server/config/*.local.php
server/config/secrets.php
server/config/credentials.php
server/config/database.local.php
server/config/config.local.php

# ==========================================
# 2. Authentication Tokens, Keys & Certificates
# ==========================================
*.token
*.jwt
*.secret
*.key
*.pem
*.pub
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
id_rsa*
id_ecdsa*
id_ed25519*
*token*.txt
*secret*.txt
*cred*.txt
*password*.txt
*auth*.txt
auth.json
secrets.json
credentials.json
client_secret*.json
service-account*.json

# ==========================================
# 3. Payment Gateway, SMS & Mailer Credentials
# ==========================================
*paymongo*.json
*gcash*.json
*maya*.json
*stripe*.json
*paypal*.json
*smtp*.json
*mailer*.json
*twilio*.json
*semaphore*.json

# ==========================================
# 4. Database Dumps, Backups & Local DBs
# ==========================================
# Root-level & exported database files
/*.sql
*.dump
*.sql.bak
*.sql.gz
*.sql.bz2
*.sqlite
*.sqlite3
*.db
*.rdb
*backup*.sql
*dump*.sql
*export*.sql
/backups/
/database_backups/

# Whitelist core database migrations and seed templates for deployment
!server/db/schema.sql
!server/db/seeds.sql
!server/db/migrations/*.sql

# ==========================================
# 5. Customer Data, Financial Exports & Receipts
# ==========================================
/receipts/
/invoices/
/exports/
/reports/export/
*customer_export*
*sales_export*
*financial_report*
*transactions*.csv
*payout*.xlsx
*.csv
*.xlsx
*.xls
*.pdf

# Allow static template assets and images
!assets/**

# ==========================================
# 6. Session Files & Auth Cache
# ==========================================
sess_*
*.session
cookies.txt
.sessions/

# ==========================================
# 7. User Uploads, Customer Attachments & Storage
# ==========================================
/uploads/
/storage/
/attachments/
/public/uploads/
/assets/uploads/
!/uploads/.gitkeep
!/assets/images/

# ==========================================
# 8. Scratch, Test & Debugging Scripts
# ==========================================
/scratch/
scratch_*
test_*.php
test_*.js
debug_*.php
audit_*.js
apply_*.js
check_*.js
build_*.js
temp_*.js
temp_*.php

# ==========================================
# 9. Logs, PID & Debugging Output
# ==========================================
*.log
error_log
php_errors.log
access_log
access.log
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
.phpunit.result.cache

# ==========================================
# 10. Dependencies & Vendor Directories
# ==========================================
/node_modules/
/vendor/
composer.phar
.npm/
.pnpm-store/

# ==========================================
# 11. Temporary Files & Build Caches
# ==========================================
tmp/
temp/
*.tmp
*.bak
*.old
*.orig
.cache/
.parcel-cache/
.turbo/
.sass-cache/

# ==========================================
# 12. Cloud Platforms & Dev Tool State
# ==========================================
.railway/
.vercel/
.netlify/
.envrc
.aws/
.ssh/

# ==========================================
# 13. IDEs, Editors & AI Workspaces
# ==========================================
.vscode/
.idea/
.fleet/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.gemini/
.agents/
.cursor/
.windsurf/
.claude/

# ==========================================
# 14. Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Dd]esktop.ini