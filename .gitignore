# ==========================================
# Dependencies & Package Managers
# ==========================================
/node_modules/
/vendor/
composer.phar
.npm
.pnpm-store

# ==========================================
# Environment & Secrets (NEVER COMMIT)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Database Exports & Dumps (Prevents Data Leaks)
# ==========================================
# Exclude root SQL exports (e.g. phpMyAdmin / MySQL Workbench dumps)
/*.sql
*.dump
*.sql.bak
*.sql.gz
*.sqlite
*.sqlite3
*.db
*backup*.sql
*dump*.sql

# ==========================================
# SSL / TLS Certificates & Private Keys
# ==========================================
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# ==========================================
# Logs & Debugging Files
# ==========================================
error_log
php_errors.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Temporary & Cache Files
# ==========================================
tmp/
temp/
*.tmp
*.bak

# ==========================================
# Operating System & IDE Files
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini