# ==============================================================================
# NELY'S SALON MANAGEMENT SYSTEM — .gitignore
# Comprehensive Security, Privacy & Confidentiality Rules:
# - Secrets, Environment Variables & API Keys
# - Authentication Tokens, Certificates & Private Keys
# - Payment Gateway, SMS, Webhook & Mailer Secrets
# - Database Dumps, Backups & Local Database Files
# - Customer Data, Financial Reports, Receipts & Invoices
# - User Uploads, Customer Attachments & Media Storage
# - PHP Sessions, Cookies & Auth Caches
# - Scratch, Audit, Simulation & Debugging Scripts
# - Server Logs, Error Logs & Process IDs
# - Local Server Configurations (XAMPP, Apache, PHP overrides)
# - Dependencies & Package Manager Artifacts
# - Build Caches, Temporary Files & Backups
# - Cloud CLI State, Platform Metadata & Postman Environments
# - IDEs, Code Editors, AI Assistant Metadata & OS Artifacts
# - Archives, Compressed Backups & Database Client Caches
# ==============================================================================

# ==========================================
# 1. Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
.env.local
.env.development
.env.staging
.env.production
.env.backup
.env.vault
.env.keys
.env.me
.env.dist.local
*.env
*.env.php
!/.env.example

# Local server configurations & database overrides
server/config/*.local.php
server/config/secrets.php
server/config/credentials.php
server/config/database.local.php
server/config/config.local.php
server/config/env.local.php
config.local.php
database.local.php

# ==========================================
# 2. Authentication Tokens, Keys & Certificates
# ==========================================
*.token
*.jwt
*.secret
*.key
*.pem
*.pub
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
*.csr
*.kdbx
*.ovpn
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
known_hosts
authorized_keys
*token*.txt
*secret*.txt
*cred*.txt
*password*.txt
*auth*.txt
*api_key*
*apikey*
*.passwd
*.pass
*htpasswd
auth.json
secrets.json
credentials.json
client_secret*.json
service-account*.json
credentials/
secrets/
keys/
certs/
certificates/

# ==========================================
# 3. Payment Gateway, SMS, Webhooks & Mailer Credentials
# ==========================================
*paymongo*.json
*gcash*.json
*maya*.json
*stripe*.json
*paypal*.json
*xendit*.json
*dragonpay*.json
*smtp*.json
*mailer*.json
*twilio*.json
*semaphore*.json
*sendgrid*.json
*mailgun*.json
*webhook_secret*
*.postman_environment.json
*thunder-client*.json
*insomnia*.json
*http-client.env.json
*rest-client.env.json

# ==========================================
# 4. Database Dumps, Backups & Local DBs
# ==========================================
# Root-level & exported database files
/*.sql
*.dump
*.sql.bak
*.sql.gz
*.sql.bz2
*.sql.tar.gz
*.sqlite
*.sqlite3
*.db
*.rdb
*backup*.sql
*dump*.sql
*export*.sql
*snapshot*.sql
/backups/
/database_backups/
/db_backups/
/dumps/

# Whitelist core database migrations and seed templates for deployment
!server/db/schema.sql
!server/db/seeds.sql
!server/db/migrations/*.sql

# ==========================================
# 5. Customer Data, Financial Exports, Receipts & Invoices
# ==========================================
/receipts/
/invoices/
/exports/
/reports/export/
/downloads/
/data/
*customer_export*
*sales_export*
*financial_report*
*transactions*.csv
*payout*.xlsx
*customer_dump*
*users_export*
*.csv
*.xlsx
*.xls
*.pdf
*.tsv
*.ods

# Allow static assets and documentation
!assets/**
!docs/**

# ==========================================
# 6. Session Files & Auth Cache
# ==========================================
sess_*
*.session
cookies.txt
.sessions/
/sessions/
/php_session/

# ==========================================
# 7. User Uploads, Customer Attachments & Storage
# ==========================================
/uploads/
/storage/
/attachments/
/public/uploads/
/assets/uploads/
/media/uploads/
!/uploads/.gitkeep
!/assets/images/

# ==========================================
# 8. Scratch, Test, Audit & Debugging Scripts
# ==========================================
/scratch/
scratch_*
test_*.php
test_*.js
debug_*.php
debug_*.js
audit_*.js
audit_*.php
apply_*.js
check_*.js
build_*.js
temp_*.js
temp_*.php
simulate_*.js

# ==========================================
# 9. Logs, PID & Debugging Output
# ==========================================
*.log
error_log
php_errors.log
access_log
access.log
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
.phpunit.result.cache

# ==========================================
# 10. Local Server (XAMPP / Apache / PHP) Overrides
# ==========================================
httpd.conf.local
php.ini.local
*.sock
*.socket

# ==========================================
# 11. Dependencies & Vendor Directories
# ==========================================
/node_modules/
/vendor/
composer.phar
.npm/
.pnpm-store/
.yarn/

# ==========================================
# 12. Temporary Files, Caches & Archives
# ==========================================
tmp/
temp/
*.tmp
*.bak
*.old
*.orig
*.swp
*.swo
*~
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
.cache/
.parcel-cache/
.turbo/
.sass-cache/

# ==========================================
# 13. Cloud Platforms & Dev Tool State
# ==========================================
.railway/
.vercel/
.netlify/
.envrc
.aws/
.ssh/
.gcloud/
.azure/
.docker/

# ==========================================
# 14. IDEs, Editors, Database Tools & AI Workspaces
# ==========================================
.vscode/
.idea/
.fleet/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
.gemini/
.agents/
.cursor/
.windsurf/
.claude/
.copilot/
.dbeaver/
.navicat/
.tableplus/

# ==========================================
# 15. Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Dd]esktop.ini